# k8s-llm-rca-bench - Environment Variables Template
# Copy this to .env and fill in your keys.

# 1. LLM API Keys (At least one required)
# NVIDIA NIM API (Primary platform for Llama/Mistral/GLM)
NVIDIA_API_KEY=your_nvidia_nim_key_here

# OpenAI API (Comparison models)
OPENAI_API_KEY=your_openai_key_here

# Anthropic API (Comparison models)
ANTHROPIC_API_KEY=your_anthropic_key_here

# 2. Kubernetes Configuration (Optional, defaults to local context)
# KUBECONFIG=~/.kube/config

# 3. AWS Configuration (Professional environment setup)
# AWS_DEFAULT_REGION=us-east-1
